---
import Base from '../layouts/Base.astro';
import PortfolioCard from './PortfolioCard.astro';
import BookNow from './BookNow.astro';
import { UI, tr, isFallback, homePath, categoryPath, type Lang } from '../lib/i18n';
import { getContent, visiblePortfolios, whatsappUrl, type Category } from '../lib/content';
interface Props { lang: Lang; category: Category }
const { lang, category: cat } = Astro.props;
const c = await getContent();
const t = UI[lang];
const s = c.settings;
const fb = (v: any) => (isFallback(v, lang) ? 'es' : undefined);
const title = tr(cat.title, lang);
const items = visiblePortfolios(c).filter((p) => p.categoryId === cat._id);
const waText = `${tr(s.whatsappMessage, lang)} ${title}.`;
const alternates = { es: categoryPath('es', cat._id), en: categoryPath('en', cat._id) };
---
<Base lang={lang} title={`${title} | ${s.siteName}`} description={tr(cat.description, lang)} alternates={alternates} waText={waText}>
  <section class="pf-hero">
    <div class="wrap">
      <p class="crumbs"><a href={homePath(lang)}>{t.homeLabel}</a> / <a href={`${homePath(lang)}#experiencias`}>{t.navExperiences}</a></p>
      <div class="lockup">
        <h1 class="display" lang={fb(cat.title)}>{title}</h1>
      </div>
      {cat.description && <p class="intro" lang={fb(cat.description)}>{tr(cat.description, lang)}</p>}
    </div>
  </section>
  <section aria-label={t.navPortfolios} style="padding-top:clamp(1rem,3vw,2rem)">
    <div class="wrap">
      {items.length ? (
        <div class="cards">{items.map((p) => <PortfolioCard lang={lang} portfolio={p} />)}</div>
      ) : (
        <p class="lead">{t.categoryEmpty}</p>
      )}
      <p style="margin-top:2rem"><a class="btn btn--ghost" href={`${homePath(lang)}#experiencias`}>{t.allCategories}</a></p>
    </div>
  </section>
  <hr class="rule" />
  <BookNow lang={lang} waText={waText} />
</Base>
