---
import Base from '../layouts/Base.astro';
import PlanCard from './PlanCard.astro';
import PortfolioCard from './PortfolioCard.astro';
import BookNow from './BookNow.astro';
import WaIcon from './WaIcon.astro';
import { UI, tr, isFallback, homePath, portfolioPath, type Lang } from '../lib/i18n';
import { getContent, plansFor, illustrationFor, visiblePortfolios, whatsappUrl, type Portfolio } from '../lib/content';
interface Props { lang: Lang; portfolio: Portfolio }
const { lang, portfolio: p } = Astro.props;
const c = await getContent();
const t = UI[lang];
const s = c.settings;
const fb = (v: any) => (isFallback(v, lang) ? 'es' : undefined);
const title = tr(p.title, lang);
const alternates: Partial<Record<Lang, string>> = {};
if (p.slug.es) alternates.es = portfolioPath('es', p.slug.es);
if (p.slug.en) alternates.en = portfolioPath('en', p.slug.en);
const retired = !visiblePortfolios(c).some((x) => x._id === p._id);
const plans = retired ? [] : plansFor(c, p._id);
const art = illustrationFor(p);
const others = visiblePortfolios(c).filter((x) => x._id !== p._id);
const related = [...others.filter((x) => x.categoryId === p.categoryId), ...others.filter((x) => x.categoryId !== p.categoryId)].slice(0, 3);
const waText = `${tr(s.whatsappMessage, lang)} ${title}.`;
const desc = tr(p.seoDescription, lang) || tr(p.intro, lang);
const themeClass = `theme-${p.theme}`;
const photoStyle = p.theme === 'romantic' && art?.kind === 'photo' ? `--photo: url('${art.src}')` : undefined;
---
<Base lang={lang} title={`${title} | ${s.siteName}`} description={desc} alternates={alternates} noindex={retired} bodyClass={themeClass} waText={waText}>
  {retired ? (
    <section class="system">
      <div class="wrap">
        <h1 class="display">{t.retiredTitle}</h1>
        <p>{t.retiredText}</p>
        <a class="btn" href={`${homePath(lang)}#portafolios`}>{t.allPortfolios}</a>
      </div>
    </section>
  ) : (
    <>
      <section class="pf-hero" style={photoStyle}>
        <div class="wrap">
          <p class="crumbs"><a href={homePath(lang)}>{lang === 'es' ? 'Inicio' : 'Home'}</a> / <a href={`${homePath(lang)}#portafolios`}>{t.navPortfolios}</a></p>
          <div class="pf-hero-grid">
            <div>
              <div class="lockup">
                <h1 class="display" lang={fb(p.title)}>{title}</h1>
                {p.kicker && <div class="sub"><span class="tag" lang={fb(p.kicker)}>{tr(p.kicker, lang)}</span></div>}
              </div>
              {p.intro && <p class="intro" lang={fb(p.intro)}>{tr(p.intro, lang)}</p>}
              <a class="btn" href={whatsappUrl(s, waText)} target="_blank" rel="noopener"><WaIcon />{t.quote}<span class="sr-only"> {t.newTab}</span></a>
            </div>
            {art && art.kind === 'line' && <div class="art"><img src={art.src} alt="" /></div>}
          </div>
        </div>
      </section>

      <section aria-label={t.plans} style="padding-top:clamp(1rem,3vw,2rem)">
        <div class="wrap">
          <div class:list={['plans', plans.length === 1 && 'single']}>
            {plans.map((plan) => <PlanCard lang={lang} plan={plan} portfolio={p} />)}
          </div>
        </div>
      </section>
    </>
  )}

  {related.length > 0 && (
    <section class="related" aria-labelledby="rel-title" style="padding-top:0">
      <div class="wrap">
        <hr class="rule" style="margin-bottom:clamp(2rem,5vw,3rem)" />
        <h2 class="display" id="rel-title" style="font-size:clamp(1.1rem,3vw,1.5rem);margin-bottom:1.6rem">{t.related}</h2>
        <div class="cards">{related.map((x) => <PortfolioCard lang={lang} portfolio={x} />)}</div>
        <p style="margin-top:2rem"><a class="btn btn--ghost" href={`${homePath(lang)}#portafolios`}>{t.allPortfolios}</a></p>
      </div>
    </section>
  )}
  <hr class="rule" />
  <BookNow lang={lang} waText={waText} />
</Base>
