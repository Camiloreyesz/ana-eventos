---
import { UI, tr, type Lang } from '../lib/i18n';
import { getContent, whatsappUrl } from '../lib/content';
interface Props { lang: Lang; waText?: string }
const { lang, waText } = Astro.props;
const { settings } = await getContent();
const t = UI[lang];
const href = whatsappUrl(settings, waText || `${tr(settings.whatsappMessage, lang)} ${lang === 'es' ? 'los eventos' : 'events'}.`);
---
<section class="book" id="reservar" aria-labelledby="book-title">
  <div class="wrap">
    <h2 class="display" id="book-title">{t.bookNow}</h2>
    <p>{t.bookText}</p>
    <a class="phone" href={href} target="_blank" rel="noopener" aria-label={`WhatsApp ${settings.whatsappDisplay} ${t.newTab}`}>{settings.whatsappDisplay}</a>
    <div class="feeling"><span>Ana is a</span><span class="tag">feeling</span></div>
  </div>
</section>
