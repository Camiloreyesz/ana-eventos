# Variables de compilación del sitio (configúralas en Netlify > Project configuration > Environment variables)
# Sin SANITY_PROJECT_ID el sitio usa content/seed.json (contenido inicial del PDF).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
# Solo si el dataset es privado (token de solo lectura "Viewer"). Nunca uses un token de escritura aquí.
SANITY_READ_TOKEN=
# Dominio propio cuando se conecte (si no, Netlify usa su variable URL automáticamente)
SITE_URL=
