---
import '@fontsource/krona-one/400.css';
import '@fontsource-variable/dm-sans/index.css';
import '@fontsource-variable/dm-sans/wght-italic.css';
import '@fontsource/italiana/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI, type Lang } from '../lib/i18n';
import { getContent, whatsappUrl } from '../lib/content';
import { tr } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Rutas equivalentes en cada idioma (para hreflang y el selector). */
  alternates: Partial<Record<Lang, string>>;
  noindex?: boolean;
  bodyClass?: string;
  waText?: string;
  ogImage?: string;
  /** La portada trae su propio bloque de contacto y pie. */
  hideFooter?: boolean;
}
const { lang, title, description, alternates, noindex = false, bodyClass = '', waText, ogImage, hideFooter = false } = Astro.props;
const { settings } = await getContent();
const other = lang === 'es' ? 'en' : 'es';
const altHref = alternates[other] || `/${other}/`;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const desc = description || tr(settings.seoDescription, lang);
const waHref = whatsappUrl(settings, waText || `${tr(settings.whatsappMessage, lang)} ${UI[lang].waTopicEvents}.`);
const og = new URL(ogImage || '/og-ana.png', site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {!noindex && Object.entries(alternates).map(([l, href]) => (
      <link rel="alternate" hreflang={l} href={new URL(href!, site).href} />
    ))}
    {!noindex && alternates.es && <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#e5e7d3" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class={bodyClass}>
    <Header lang={lang} altHref={altHref} waHref={waHref} />
    <main id="contenido">
      <slot />
    </main>
    {!hideFooter && <Footer lang={lang} settings={settings} waHref={waHref} />}
  </body>
</html>
