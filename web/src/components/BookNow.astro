---
import { UI, tr, isFallback, type Lang } from '../lib/i18n';
import { getContent, getPortada, whatsappUrl } from '../lib/content';
import WaIcon from './WaIcon.astro';
interface Props { lang: Lang; waText?: string }
const { lang, waText } = Astro.props;
const { settings } = await getContent();
const P = getPortada();
const t = UI[lang];
const fb = (v: any) => (isFallback(v, lang) ? 'es' : undefined);
const href = whatsappUrl(settings, waText || `${tr(settings.whatsappMessage, lang)} ${t.waTopicEvents}.`);
---
<section class="book" id="reservar" aria-labelledby="book-title">
  <div class="wrap">
    <h2 class="display" id="book-title" lang={fb(P.contact.title)}>{tr(P.contact.title, lang)}</h2>
    <p lang={fb(P.contact.text)}>{tr(P.contact.text, lang)}</p>
    <a class="btn-wa" href={href} target="_blank" rel="noopener"><WaIcon />{t.writeWhatsapp}<span class="sr-only"> {t.newTab}</span></a>
  </div>
</section>
